/* The Top Bar */
.topNavbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  background-color: #ffffff;
  border-bottom: 1px solid #e2e8f0;
  height: 60px;
}

/* The Core Layout (3 Columns when AI is ON) */
.mainGrid {
  display: grid;
  /* 350px for AI, 1fr for Editor, 400px for PDF Preview */
  grid-template-columns: 350px 1fr 400px; 
  height: calc(100vh - 60px);
  transition: all 0.3s ease-in-out;
}

/* The Magic Trick: 2 Columns when AI is OFF */
.mainGrid.aiHidden {
  /* The AI column collapses, Editor expands! */
  grid-template-columns: 1fr 400px; 
}

/* --- Basic Toggle Switch Styles --- */
.switch { position: relative; display: inline-block; width: 44px; height: 24px; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; border-radius: 34px; transition: .4s; }
.slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; border-radius: 50%; transition: .4s; }
input:checked + .slider { background-color: #4f46e5; /* Purple/Indigo color */ }
input:checked + .slider:before { transform: translateX(20px); }
.proToggleContainer { display: flex; align-items: center; gap: 10px; }
</file>

