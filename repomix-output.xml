      <div className="flex items-center gap-4 mb-6">
        <div className="h-px bg-slate-200 flex-1"></div>
        <span className="text-xs font-bold text-slate-400 uppercase tracking-widest">Or register with email</span>
        <div className="h-px bg-slate-200 flex-1"></div>
