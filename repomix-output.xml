import React, { useState, useEffect, useRef } from 'react';
import { useResumeStore } from '../store/useResumeStore';
import { Download, Share2, Lock, Copy, Type, Maximize, FileText, CheckCircle2, ChevronDown } from 'lucide-react';
import { TemplateSelector } from './TemplateSelector';
import api from '../utils/api';

const ScaledA4Viewer = ({ children, pages }) => {
  const containerRef = useRef(null);
  const [scale, setScale] = useState(1);
  const A4_HEIGHT = 1123;
  const GAP = 24;

  useEffect(() => {
    const observer = new ResizeObserver((entries) => {
      for (let entry of entries) {
        if (entry.target === containerRef.current) {
          const availableWidth = entry.contentRect.width - 40;
          setScale(Math.min(availableWidth / 794, 1.1));
        }
      }
    });

    if (containerRef.current) observer.observe(containerRef.current);
    return () => observer.disconnect();
  }, []);

  return (
    <div ref={containerRef} className="w-full flex justify-center pt-28 pb-32">
      <div
        style={{
          width: `${794 * scale}px`,
          height: `${((pages * A4_HEIGHT) + ((pages - 1) * GAP)) * scale}px`,
          transformOrigin: 'top center',
          position: 'relative'
        }}
      >
        <div
          style={{
            width: '794px',
            height: `${(pages * A4_HEIGHT) + ((pages - 1) * GAP)}px`,
            transform: `scale(${scale})`,
            transformOrigin: 'top left',
            position: 'absolute',
            top: 0, left: 0
          }}
        >
            <div className="absolute inset-0 z-0 flex flex-col pointer-events-none" style={{ gap: `${GAP}px` }}>
                {Array.from({ length: pages }).map((_, i) => (
                    <div key={i} className="w-full bg-white shadow-xl rounded-sm border border-slate-200/60 shrink-0" style={{ height: `${A4_HEIGHT}px` }} />
                ))}
            </div>
            <div className="absolute inset-0 z-10 w-full">
                {children}
            </div>
        </div>
      </div>
    </div>
  );
};

const renderSkillText = (text) => {
    if (typeof text === 'string' && text.includes(':')) {
      const parts = text.split(':');
      return <><span style={{ fontWeight: '600', color: '#111827' }}>{parts[0]}:</span>{parts.slice(1).join(':')}</>;
    }
    return typeof text === 'string' ? text : '';
};

const formatDates = (start, end) => {
    if (start && end) return `${start} - ${end}`;
    if (start) return start;
    if (end) return end;
    return '';
};

const DynamicTemplate = ({ data, templateStyle, documentStyle, onPagesCalculated }) => {
    const containerRef = useRef(null);
    const lastPageCount = useRef(1);
    const personal = data.personalInfo || data.personalDetails || {};
    const sections = data.sections || [];
    const fullName = personal.name || `${personal.firstName || ''} ${personal.lastName || ''}`.trim() || 'Your Name';
    
    const sizeMap = { compact: '9.5pt', standard: '10.5pt', spacious: '11.5pt' };
    const currentFontSize = sizeMap[documentStyle?.fontSize] || '10.5pt';
    const currentFontFamily = documentStyle?.fontFamily || 'Helvetica, Arial, sans-serif';

    useEffect(() => {
        if (!containerRef.current) return;
        const A4_HEIGHT = 1123;
        const GAP = 24;
        const TOP_PAD = 40;
        const BOTTOM_PAD = 50;
        const domSections = Array.from(containerRef.current.querySelectorAll('.resume-section'));

        domSections.forEach(s => s.style.marginTop = '0px');

        let pageCount = 1;
        domSections.forEach((section) => {
            const top = section.offsetTop;
            const height = section.offsetHeight;
            const currentPageBottom = (pageCount * A4_HEIGHT) + ((pageCount - 1) * GAP);

            if (top + height > currentPageBottom - BOTTOM_PAD) {
                const nextPageStart = currentPageBottom + GAP + TOP_PAD;
                const pushAmount = Math.max(0, nextPageStart - top);
                section.style.marginTop = `${pushAmount}px`;
                pageCount++;
            }
        });

        if (pageCount !== lastPageCount.current) {
            lastPageCount.current = pageCount;
            onPagesCalculated(pageCount);
        }
    }, [data, documentStyle, templateStyle, onPagesCalculated]);

    let titleStyle = {
        fontSize: '1.25em', fontWeight: 'bold', borderBottom: '1.5px solid #000',
        paddingBottom: '2px', marginBottom: '10px', marginTop: '16px', color: '#000'
    };

    return (
      <div id="resume-render-container" ref={containerRef} style={{ fontFamily: currentFontFamily, fontSize: currentFontSize, color: '#1f2937', width: '100%', boxSizing: 'border-box', lineHeight: '1.5', paddingTop: '40px' }}>
        <div className="resume-section" style={{ textAlign: 'center', marginBottom: '16px', padding: '0 50px' }}>
          <div style={{ fontSize: '2.4em', fontWeight: 'bold', color: '#000', letterSpacing: '-0.01em', marginBottom: '4px' }}>
            {fullName}
          </div>
          <div style={{ fontSize: '0.95em', color: '#374151', display: 'flex', justifyContent: 'center', flexWrap: 'wrap', gap: '6px' }}>
            {[personal.email, personal.phone, personal.linkedin, personal.github, personal.location].filter(Boolean).join(' | ')}
          </div>
        </div>

        {sections.map(section => {
          if (section.key === 'personalDetails') return null;
          if (section.key === 'summary' && data.summary) return (
            <div key={section.key} className="resume-section" style={{ padding: '0 50px' }}>
              <div style={titleStyle}>{section.title}</div>
              <div style={{ textAlign: 'justify' }}>{data.summary}</div>
            </div>
          );
          if (section.key === 'experience' && data.experience?.length > 0) return (
            <div key={section.key} className="resume-section" style={{ padding: '0 50px' }}>
              <div style={titleStyle}>{section.title}</div>
              {data.experience.map((exp, i) => (
                <div key={i} style={{ marginBottom: '12px', pageBreakInside: 'avoid' }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', fontWeight: 'bold', color: '#000', fontSize: '1.05em' }}>
                    <span>{exp.position || exp.jobTitle}</span>
                    <span style={{ fontWeight: 'normal', fontSize: '0.95em' }}>{formatDates(exp.startDate, exp.endDate)}</span>
                  </div>
                  <div style={{ fontStyle: 'italic', marginBottom: '4px', color: '#111827' }}>
                    {exp.company}{exp.location ? `, ${exp.location}` : ''}
                  </div>
                  {exp.description && (
                    <ul style={{ margin: '0', paddingLeft: '18px', listStyleType: 'disc' }}>
                      {(Array.isArray(exp.description) ? exp.description : [exp.description]).filter(Boolean).map((d, j) => (
                        <li key={j} style={{ marginBottom: '3px', paddingLeft: '4px' }}>{d}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          );
          if (section.key === 'projects' && data.projects?.length > 0) return (
            <div key={section.key} className="resume-section" style={{ padding: '0 50px' }}>
              <div style={titleStyle}>{section.title}</div>
              {data.projects.map((proj, i) => (
                <div key={i} style={{ marginBottom: '12px', pageBreakInside: 'avoid' }}>
                  <div style={{ fontWeight: 'bold', color: '#000', fontSize: '1.05em' }}>{proj.name}</div>
                  {proj.description && (
                    <ul style={{ margin: '4px 0 0 0', paddingLeft: '18px', listStyleType: 'disc' }}>
                      {(Array.isArray(proj.description) ? proj.description : [proj.description]).filter(Boolean).map((d, j) => (
                        <li key={j} style={{ marginBottom: '3px', paddingLeft: '4px' }}>{d}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          );
          if (section.key === 'education' && data.education?.length > 0) return (
            <div key={section.key} className="resume-section" style={{ padding: '0 50px' }}>
              <div style={titleStyle}>{section.title}</div>
              {data.education.map((edu, i) => (
                <div key={i} style={{ marginBottom: '10px', pageBreakInside: 'avoid' }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', fontWeight: 'bold', color: '#000' }}>
                    <span>{edu.institution}</span>
                    <span style={{ fontWeight: 'bold' }}>{formatDates(edu.startDate, edu.endDate)}</span>
                  </div>
                  <div style={{ color: '#1f2937' }}>
                    {edu.degree} {edu.fieldOfStudy ? `in ${edu.fieldOfStudy}` : ''}
                  </div>
                </div>
              ))}
            </div>
          );
          
          if (section.key === 'skills' && data.skills?.length > 0) return (
            <div key={section.key} className="resume-section" style={{ padding: '0 50px' }}>
              <div style={titleStyle}>{section.title}</div>
              <ul style={{ margin: '0', paddingLeft: '18px', listStyleType: 'disc' }}>
                {(Array.isArray(data.skills) ? data.skills : [data.skills]).filter(Boolean).map((skillGroup, j) => {
                  
                  // Handle New Nested Category Format
                  if (typeof skillGroup === 'object' && skillGroup.category) {
                    const skillNames = (skillGroup.items || [])
                      .map(item => typeof item === 'string' ? item : item.name)
                      .filter(Boolean)
                      .join(', ');
                      
                    return (
                      <li key={j} style={{ marginBottom: '4px', paddingLeft: '4px', pageBreakInside: 'avoid' }}>
                        <span style={{ fontWeight: '600', color: '#111827' }}>{skillGroup.category}: </span>
                        {skillNames}
                      </li>
                    );
                  }
                  
                  // Handle Legacy Simple String Format
                  return (
                    <li key={j} style={{ marginBottom: '4px', paddingLeft: '4px', pageBreakInside: 'avoid' }}>
                        {renderSkillText(skillGroup)}
                    </li>
                  );
                  
                })}
              </ul>
            </div>
          );

          if (section.isCustom && data[section.key]) return (
            <div key={section.key} className="resume-section" style={{ padding: '0 50px' }}>
              <div style={titleStyle}>{section.title}</div>
              {section.type === 'text' ? <div style={{ whiteSpace: 'pre-wrap' }}>{data[section.key]}</div> : (
                Array.isArray(data[section.key]) && data[section.key].map((item, i) => (
                  <div key={i} style={{ marginBottom: '12px', pageBreakInside: 'avoid' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', fontWeight: 'bold', color: '#000' }}>
                      <span>{item.title}</span>
                      <span style={{ fontWeight: 'normal' }}>{item.date}</span>
                    </div>
                    {item.bulletPoints && (
                      <ul style={{ margin: '4px 0 0 0', paddingLeft: '18px', listStyleType: 'disc' }}>
                        {(Array.isArray(item.bulletPoints) ? item.bulletPoints : [item.bulletPoints]).filter(Boolean).map((b, bIdx) => (
                          <li key={bIdx} style={{ marginBottom: '3px', paddingLeft: '4px' }}>{b}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))
              )}
            </div>
          );
          return null;
        })}
      </div>
    );
};

export const PreviewPanel = () => {
  const { activeResume, toggleResumeVisibility, documentStyle, updateDocumentStyle } = useResumeStore();
  const [showTemplates, setShowTemplates] = useState(false);
  const [showShareMenu, setShowShareMenu] = useState(false);
  const [isExporting, setIsExporting] = useState(false);
  const [copied, setCopied] = useState(false);
  const [pages, setPages] = useState(1);

  if (!activeResume) return null;
  const { resumeData, templateName = 'jakes-resume' } = activeResume;

  const handleCopyLink = () => {
    const url = `${window.location.origin}/p/${activeResume.slug}`;
    navigator.clipboard.writeText(url);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const handleDownload = async () => {
    try {
      setIsExporting(true);
      const response = await api.post(`/resume/preview/${activeResume._id}`, { resumeData, templateName, documentStyle }, { responseType: 'blob' });
      const url = window.URL.createObjectURL(new Blob([response.data], { type: 'application/pdf' }));
      const link = document.createElement('a'); link.href = url; link.setAttribute('download', `${resumeData.personalInfo?.firstName || 'My'}_Resume.pdf`);
      document.body.appendChild(link); link.click(); document.body.removeChild(link);
    } catch (error) {
      alert("Failed to export PDF.");
    } finally {
      setIsExporting(false);
    }
  };

  return (
    <div className="h-full flex flex-col relative bg-[#323639] overflow-hidden">
      
      {/* Robust Toolbar Layout */}
      <div className="absolute top-6 w-full flex justify-center z-50 pointer-events-none px-4">
        <div className="bg-[#f8f9fa] shadow-[0_8px_30px_rgb(0,0,0,0.12)] rounded-2xl border border-slate-200/80 p-1.5 flex flex-wrap items-center justify-center gap-2 pointer-events-auto max-w-full">
            
            {/* Left Group */}
            <div className="flex items-center gap-1">
                <div className="flex items-center hover:bg-slate-200/50 rounded-xl px-2 sm:px-3 py-1.5 transition-colors cursor-pointer relative group">
                    <select
                        value={documentStyle?.fontFamily || 'Helvetica'}
                        onChange={(e) => updateDocumentStyle({ fontFamily: e.target.value })}
                        className="bg-transparent text-[13px] sm:text-[14px] font-bold text-slate-700 outline-none cursor-pointer appearance-none pr-4"
                    >
                        <option value="Times-Roman">Classic</option>
                        <option value="Helvetica">Modern</option>
                    </select>
                    <ChevronDown size={14} className="absolute right-1 text-slate-400 pointer-events-none"/>
                </div>

                <div className="w-px h-5 bg-slate-300 mx-1"></div>

                <div className="flex items-center hover:bg-slate-200/50 rounded-xl px-2 sm:px-3 py-1.5 transition-colors cursor-pointer relative group">
                    <select
                        value={documentStyle?.fontSize || 'standard'}
                        onChange={(e) => updateDocumentStyle({ fontSize: e.target.value })}
                        className="bg-transparent text-[13px] sm:text-[14px] font-bold text-slate-700 outline-none cursor-pointer appearance-none pr-4"
                    >
                        <option value="compact">Small</option>
                        <option value="standard">Normal</option>
                    </select>
                    <ChevronDown size={14} className="absolute right-1 text-slate-400 pointer-events-none"/>
                </div>
            </div>

            <div className="w-px h-5 bg-slate-300 mx-1 hidden sm:block"></div>

            {/* Right Group */}
            <div className="flex items-center gap-1.5 sm:gap-2">
                <button
                    onClick={() => setShowTemplates(true)}
                    className="flex items-center gap-1.5 text-[13px] sm:text-[14px] font-bold text-slate-700 hover:bg-slate-200/50 px-2 sm:px-3 py-1.5 rounded-xl transition-colors shrink-0"
                >
                    <FileText size={16} />
                    <span className="hidden sm:inline">Template</span>
                </button>

                <div className="relative shrink-0">
                    <button
                        onClick={() => setShowShareMenu(!showShareMenu)}
                        className={`flex items-center gap-1.5 text-[13px] sm:text-[14px] font-bold px-2 sm:px-3 py-1.5 rounded-xl transition-colors ${activeResume.isPublic ? 'text-emerald-700 bg-emerald-50/50' : 'text-slate-700 hover:bg-slate-200/50'}`}
                    >
                        <Share2 size={16}/>
                        <span className="hidden sm:inline">Share</span>
                    </button>
                    {showShareMenu && (
                        <div className="absolute right-0 mt-3 w-64 bg-white border border-slate-200 rounded-2xl shadow-2xl overflow-hidden z-50">
                            <div className="p-3.5 bg-slate-50 border-b border-slate-100 flex items-center justify-between">
                                <span className="text-xs font-bold text-slate-700 uppercase">Public Web Link</span>
                                <input type="checkbox" checked={activeResume.isPublic} onChange={() => toggleResumeVisibility(activeResume._id, activeResume.isPublic)} className="accent-indigo-600 w-4 h-4 cursor-pointer" />
                            </div>
                            <div className="p-3.5 flex flex-col gap-3">
                                {activeResume.isPublic ? (
                                    <button onClick={handleCopyLink} className="w-full py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-[13px] font-bold rounded-xl border border-indigo-200 transition-colors">
                                        {copied ? 'Link Copied!' : 'Copy Link'}
                                    </button>
                                ) : (
                                    <p className="text-[12px] text-slate-500 text-center">Enable sharing to get link.</p>
                                )}
                            </div>
                        </div>
                    )}
                </div>
                
                <button
                    onClick={handleDownload}
                    disabled={isExporting}
                    className="bg-[#0f172a] hover:bg-indigo-600 text-white text-[13px] sm:text-[14px] font-bold px-4 py-1.5 rounded-xl shadow-md transition-all flex items-center gap-1.5 shrink-0 disabled:opacity-70"
                >
                    <Download size={16}/>
                    <span className="hidden sm:inline">{isExporting ? 'Building...' : 'Download'}</span>
                </button>
            </div>
        </div>
      </div>

      <div className="flex-1 overflow-auto relative custom-scrollbar">
        <ScaledA4Viewer pages={pages}>
          <DynamicTemplate
             data={resumeData}
             templateStyle={templateName}
             documentStyle={documentStyle || {}}
             onPagesCalculated={setPages}
          />
        </ScaledA4Viewer>
      </div>
      <TemplateSelector isOpen={showTemplates} onClose={() => setShowTemplates(false)} />
    </div>
  );
};
