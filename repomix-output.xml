    danger: "bg-red-50 text-red-600 hover:bg-red-100",
  };

  return (
    <motion.button
      whileTap={{ scale: 0.98 }}
      className={cn("px-5 py-2.5 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2", styles[variant], className)}
      {...props}
    >
      {children}
    </motion.button>
  );
};
