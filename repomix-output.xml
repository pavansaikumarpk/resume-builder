      <p className="mt-6 text-center text-sm font-medium text-slate-500">
        Already have an account?{' '}
        <Link to="/login" className="font-bold text-indigo-600 hover:text-indigo-800 transition-colors">
          Sign In
        </Link>
      </p>
    </AuthLayout>
  );
};
