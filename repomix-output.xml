<file path="backend/controllers/ai-controller.js">
const axios = require('axios');

// ============================================================
// UTILITIES
// ============================================================

const extractCleanJSON = (rawText) => {
  if (!rawText) throw new Error("Empty response received from AI engine.");

  let cleanText = rawText
    .replace(/```json/gi, '')
    .replace(/```/g, '')
    .trim();

  const firstBrace = cleanText.indexOf('{');
  const lastBrace = cleanText.lastIndexOf('}');

  if (firstBrace === -1 || lastBrace === -1) {
    throw new Error("AI response did not contain a valid JSON object structure.");
  }

  return JSON.parse(cleanText.substring(firstBrace, lastBrace + 1));
};

const getAIConfig = () => {
  const apiKey = process.env.OPENROUTER_API_KEY || process.env.GROQ_API_KEY || process.env.OPENAI_API_KEY;
  const baseUrl = process.env.AI_BASE_URL || "https://api.groq.com/openai/v1/chat/completions";
  const modelName = process.env.AI_MODEL_NAME || "llama-3.3-70b-versatile";
  if (!apiKey) throw new Error("Missing AI Authentication Keys in Server Environment Variables.");
  return { apiKey, baseUrl, modelName };
};

const callAIEngine = async (prompt, systemInstruction, options = {}) => {
  const { apiKey, baseUrl, modelName } = getAIConfig();

  const response = await axios.post(
    baseUrl,
    {
      model: modelName,
      messages: [
        { role: "system", content: systemInstruction },
        { role: "user", content: prompt }
      ],
      temperature: options.temperature ?? 0.0,
      response_format: options.jsonMode !== false ? { type: "json_object" } : undefined,
      max_tokens: options.maxTokens || 4096,
    },
    {
      headers: {
        "Authorization": `Bearer ${apiKey}`,
        "Content-Type": "application/json",
        "HTTP-Referer": "https://resumn.com",
        "X-Title": "Resumn SaaS Engine"
      },
      timeout: options.timeout || 30000
    }
  );

  if (!response.data?.choices?.length) {
    throw new Error("Invalid payload structure returned from upstream AI provider.");
  }

  return response.data.choices[0].message.content;
};

// Merges AI output back onto original array, preserving IDs and falling back to original on failure.
const safeMergeArray = (originalArray, aiArray) => {
  if (!Array.isArray(originalArray) || originalArray.length === 0) return originalArray || [];
  if (!Array.isArray(aiArray) || aiArray.length === 0) return originalArray;

  return originalArray.map((origItem, index) => {
    // Match by ID first, then by position
    const matchedAiItem = aiArray.find(ai =>
      (ai.id && ai.id === origItem.id) ||
      (ai._id && ai._id === origItem._id)
    ) || aiArray[index];

    if (!matchedAiItem) return origItem; // Safety net: original is always preserved

    return {
      ...origItem,
      ...matchedAiItem,
      // Lock IDs — AI must never change these
      id: origItem.id,
      _id: origItem._id,
    };
  });
};

// ============================================================
// SECTION-BY-SECTION AI OPTIMIZER
// This is the core fix: instead of sending the entire resume
// in one shot (which causes the LLM to skip/truncate sections),
// we process each section independently and in parallel.
// ============================================================

/**
 * Optimizes bullet points (description arrays) for a section.
 * If existing bullets are present, it IMPROVES them.
 * If empty/missing, it GENERATES relevant ones from scratch.
 */
const optimizeSectionItems = async (items, sectionType, jobDescription, sectionLabel) => {
  if (!Array.isArray(items) || items.length === 0) return items;

  // Build a compact inventory so the AI knows exactly what to process
  const inventory = items.map((item, i) => ({
    _index: i,
    // Preserve the item's title/name field based on section type
    title: item.position || item.name || item.title || item.role || `Item ${i + 1}`,
    // The actual bullets — could be empty for new resumes
    bullets: Array.isArray(item.description)
      ? item.description.filter(b => b && b.trim().length > 0)
      : [],
  }));

  const systemInstruction = `You are a precision ATS resume optimizer. You will receive a list of ${sectionLabel} items and a Job Description.

YOUR MISSION FOR EACH ITEM:
- If the item has EXISTING bullets: REWRITE each bullet to be stronger. Use power verbs, add quantified impact where plausible, and inject keywords from the JD. Keep the same number of bullets.
- If the item has EMPTY bullets: GENERATE 3-4 highly relevant ATS-optimized bullets based on the item's title and the JD context.

ABSOLUTE RULES:
1. NEVER drop an item. Output the same count as input.
2. NEVER invent technologies or tools not mentioned in the item title or existing bullets.
3. NEVER add placeholder text, commentary, or instructional text.
4. Each bullet must start with a strong past-tense action verb (Led, Built, Designed, Reduced, Increased...).
5. Return ONLY valid JSON — no markdown, no preamble.`;

  const prompt = `JOB DESCRIPTION:
"""
${jobDescription}
"""

${sectionLabel.toUpperCase()} ITEMS TO OPTIMIZE (${inventory.length} items — process ALL of them):
${JSON.stringify(inventory, null, 2)}

Return a JSON object with this EXACT schema:
{
  "optimized": [
    {
      "_index": 0,
      "bullets": ["Improved bullet 1...", "Improved bullet 2..."]
    }
  ]
}

CRITICAL: The "optimized" array MUST have exactly ${inventory.length} items.`;

  try {
    const rawOutput = await callAIEngine(prompt, systemInstruction, { maxTokens: 3000, timeout: 25000 });
    const parsed = extractCleanJSON(rawOutput);

    if (!Array.isArray(parsed.optimized) || parsed.optimized.length !== items.length) {
      console.warn(`[AI] ${sectionLabel}: expected ${items.length} items, got ${parsed.optimized?.length}. Falling back to originals.`);
      return items;
    }

    // Merge the improved bullets back onto the original items
    return items.map((origItem, i) => {
      const aiResult = parsed.optimized.find(r => r._index === i) || parsed.optimized[i];
      if (!aiResult || !Array.isArray(aiResult.bullets) || aiResult.bullets.length === 0) {
        return origItem; // Fallback to original if AI failed for this item
      }
      return { ...origItem, description: aiResult.bullets };
    });

  } catch (err) {
    console.error(`[AI] Failed to optimize ${sectionLabel}:`, err.message);
    return items; // Graceful fallback: return originals untouched
  }
};

/**
 * Optimizes the summary field.
 */
const optimizeSummary = async (summary, jobDescription) => {
  if (!summary || typeof summary !== 'string' || summary.trim().length === 0) {
    // Generate a summary from scratch based on JD
    try {
      const rawOutput = await callAIEngine(
        `Generate a 2-3 sentence ATS-optimized professional summary for someone applying to this role:\n${jobDescription}`,
        `You are an ATS resume writer. Return ONLY valid JSON: { "summary": "..." }`,
        { maxTokens: 300 }
      );
      return extractCleanJSON(rawOutput).summary || summary;
    } catch {
      return summary;
    }
  }

  try {
    const rawOutput = await callAIEngine(
      `Rewrite this professional summary to better match the JD. Keep it 2-3 sentences, one paragraph, no lists.\n\nCURRENT SUMMARY: "${summary}"\n\nJOB DESCRIPTION:\n${jobDescription}`,
      `You are an ATS resume writer. Return ONLY valid JSON: { "summary": "..." }. The summary must be a single string.`,
      { maxTokens: 300 }
    );
    const parsed = extractCleanJSON(rawOutput);
    return typeof parsed.summary === 'string' ? parsed.summary : summary;
  } catch {
    return summary;
  }
};

/**
 * Optimizes the skills section — adds missing JD keywords, removes irrelevant ones.
 */
const optimizeSkills = async (skills, jobDescription) => {
  if (!skills) return skills;

  try {
    const rawOutput = await callAIEngine(
      `Optimize this skills section for the given JD. Add missing high-priority skills from the JD that are realistic. You may remove skills that have zero relevance.\n\nSKILLS:\n${JSON.stringify(skills)}\n\nJOB DESCRIPTION:\n${jobDescription}`,
      `You are an ATS skills optimizer. Return ONLY valid JSON matching the EXACT same schema as the input skills. If input is an array of objects with "category" and "items", preserve that. If flat array of strings, preserve that. Schema: { "skills": <same format as input> }`,
      { maxTokens: 800 }
    );
    const parsed = extractCleanJSON(rawOutput);
    return parsed.skills || skills;
  } catch {
    return skills;
  }
};

/**
 * Optimizes custom sections (e.g., Achievements, Volunteering, Publications).
 * Handles both bullet-based and text-based custom sections.
 */
const optimizeCustomSections = async (customSections, jobDescription) => {
  if (!customSections || !Array.isArray(customSections) || customSections.length === 0) {
    return customSections;
  }

  try {
    const rawOutput = await callAIEngine(
      `Optimize each custom section for ATS. Improve existing content. Do not drop any section or item.\n\nCUSTOM SECTIONS:\n${JSON.stringify(customSections)}\n\nJOB DESCRIPTION:\n${jobDescription}`,
      `You are an ATS resume optimizer. Return ONLY valid JSON: { "customSections": <same structure as input, with improved text content> }. Preserve all keys, IDs, and section counts exactly.`,
      { maxTokens: 2000 }
    );
    const parsed = extractCleanJSON(rawOutput);
    return parsed.customSections || customSections;
  } catch {
    return customSections;
  }
};

// ============================================================
// REAL ATS SCORE CALCULATOR
// Scores based on actual keyword density, section completeness,
// and bullet quality signals — not random numbers.
// ============================================================
const calculateAtsScore = (resumeData, jobDescription) => {
  let score = 40; // Base score
  const jdLower = jobDescription.toLowerCase();

  // 1. Keyword matching (up to 30 points)
  const jdWords = jdLower
    .replace(/[^a-z0-9\s]/g, ' ')
    .split(/\s+/)
    .filter(w => w.length > 3);
  const uniqueJdKeywords = [...new Set(jdWords)];
  const resumeText = JSON.stringify(resumeData).toLowerCase();

  const matchedKeywords = uniqueJdKeywords.filter(kw => resumeText.includes(kw));
  const keywordDensity = matchedKeywords.length / Math.max(uniqueJdKeywords.length, 1);
  score += Math.round(keywordDensity * 30);

  // 2. Section completeness (up to 20 points)
  const sectionChecks = [
    { field: 'summary', weight: 5 },
    { field: 'experience', weight: 7 },
    { field: 'skills', weight: 5 },
    { field: 'projects', weight: 3 },
  ];
  for (const { field, weight } of sectionChecks) {
    const val = resumeData[field];
    if (val && (typeof val === 'string' ? val.trim().length > 0 : val.length > 0)) {
      score += weight;
    }
  }

  // 3. Bullet quality signals (up to 10 points)
  const powerVerbs = ['led', 'built', 'designed', 'developed', 'reduced', 'increased',
    'improved', 'delivered', 'managed', 'architected', 'optimized', 'launched', 'scaled'];
  const allBullets = [
    ...(resumeData.experience || []).flatMap(e => e.description || []),
    ...(resumeData.projects || []).flatMap(p => p.description || []),
  ].map(b => b.toLowerCase());

  const bulletsWithVerbs = allBullets.filter(b => powerVerbs.some(v => b.startsWith(v)));
  const bulletQuality = allBullets.length > 0
    ? bulletsWithVerbs.length / allBullets.length
    : 0;
  score += Math.round(bulletQuality * 10);

  // Clamp between 62 and 98
  return Math.min(98, Math.max(62, score));
};

// ============================================================
// MAIN MAGIC TAILOR HANDLER
// Processes sections in parallel for speed, with graceful
// fallbacks so a failure in one section never breaks the rest.
// ============================================================
const magicTailor = async (req, res) => {
  const { jobDescription, resumeData } = req.body;

  if (!jobDescription || !resumeData) {
    return res.status(400).json({ success: false, error: "Missing required parameters." });
  }

  try {
    // --- PHASE 1: Compute ATS score on ORIGINAL data (before optimization) ---
    // This gives an honest "before" picture; the optimized version will score higher.
    const beforeScore = calculateAtsScore(resumeData, jobDescription);

    // --- PHASE 2: Run all section optimizations IN PARALLEL ---
    // Each section is independent — a failure in one won't block others.
    const [
      optimizedSummary,
      optimizedSkills,
      optimizedExperience,
      optimizedProjects,
      optimizedCertifications,
      optimizedCustomSections,
    ] = await Promise.allSettled([
      optimizeSummary(resumeData.summary, jobDescription),
      optimizeSkills(resumeData.skills, jobDescription),
      optimizeSectionItems(resumeData.experience, 'experience', jobDescription, 'Work Experience'),
      optimizeSectionItems(resumeData.projects, 'projects', jobDescription, 'Projects'),
      optimizeSectionItems(resumeData.certifications, 'certifications', jobDescription, 'Certifications'),
      optimizeCustomSections(resumeData.customSections, jobDescription),
    ]);

    // Helper to safely extract value from allSettled result
    const safeValue = (result, fallback) =>
      result.status === 'fulfilled' ? result.value : fallback;

    // --- PHASE 3: Assemble final response ---
    const tailoredData = {
      ...resumeData,
      // Education is intentionally EXCLUDED from optimization (as requested)
      education: resumeData.education,
      summary: safeValue(optimizedSummary, resumeData.summary),
      skills: safeValue(optimizedSkills, resumeData.skills),
      experience: safeValue(optimizedExperience, resumeData.experience),
      projects: safeValue(optimizedProjects, resumeData.projects),
      certifications: safeValue(optimizedCertifications, resumeData.certifications),
      customSections: safeValue(optimizedCustomSections, resumeData.customSections),
    };

    // --- PHASE 4: Score the optimized data ---
    const afterScore = calculateAtsScore(tailoredData, jobDescription);

    return res.status(200).json({
      success: true,
      atsScore: afterScore,
      atsScoreBefore: beforeScore, // Bonus: send before score so frontend can show improvement
      tailoredData,
    });

  } catch (globalError) {
    console.error("[magicTailor] Fatal error:", globalError.message);
    return res.status(500).json({
      success: false,
      error: "Internal server optimization error encountered.",
      message: globalError.message,
    });
  }
};

// ============================================================
// SINGLE BULLET OPTIMIZER (unchanged logic, cleaner code)
// ============================================================
const optimizeBullet = async (req, res) => {
  const { bulletText, jobDescription } = req.body;

  if (!bulletText) {
    return res.status(400).json({ success: false, error: "Missing 'bulletText' input text." });
  }

  try {
    const systemInstruction = "You are an ATS formatting tool. Rewrite the bullet point to emphasize impact, metrics, and technical context. Keep it one concise sentence starting with a strong past-tense action verb. Do not invent new skills. Return plain text only — no JSON, no markdown.";
    const prompt = `Optimize this resume bullet: "${bulletText}"${jobDescription ? `\n\nTarget Job Description:\n${jobDescription}` : ''}`;

    const rawOutput = await callAIEngine(prompt, systemInstruction, {
      jsonMode: false,
      maxTokens: 200,
      timeout: 10000,
    });

    return res.status(200).json({ success: true, optimizedBullet: rawOutput.trim() });

  } catch (error) {
    console.error("[optimizeBullet] Error:", error.message);
    return res.status(500).json({ success: false, error: "Failed to optimize bullet point." });
  }
};

module.exports = { magicTailor, optimizeBullet };
