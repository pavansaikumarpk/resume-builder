// ==========================================
// 4. MAIN COMPONENT (TEMPLATE SWITCHER)
// ==========================================
const TEMPLATE_REGISTRY = {
    'harvard-ats': HarvardTemplate,
    'jakes-resume': JakesTemplate,
    'latex-classic': LatexTemplate
};

export const ResumePDF = ({ data, templateName = 'jakes-resume' }) => {
    if (!data) return null;
    
    // Fallback to Jake's template if the requested one doesn't exist
    const TemplateComponent = TEMPLATE_REGISTRY[templateName] || JakesTemplate;

    return (
        <Document>
            <TemplateComponent data={data} />
        </Document>
    );
};
