require('dotenv').config();
const fs = require('fs');
const OpenAI = require('openai');
const PDFParserModule = require('pdf2json');

const PDFParser = PDFParserModule.default || PDFParserModule;

const openai = new OpenAI({
  baseURL: "https://api.groq.com/openai/v1",
  apiKey: process.env.GROQ_API_KEY, 
});

const extractTextFromPDF = (filePath) => {
    return new Promise((resolve, reject) => {
        const pdfParser = new PDFParser(null, 1);
        pdfParser.on("pdfParser_dataError", errData => reject(errData.parserError));
        pdfParser.on("pdfParser_dataReady", () => resolve(pdfParser.getRawTextContent()));
        pdfParser.loadPDF(filePath);
    });
};

const importResume = async (req, res) => {
    try {
        if (!req.file || !req.file.path) {
            return res.status(400).json({ message: 'No valid PDF file uploaded.' });
        }

        const rawText = await extractTextFromPDF(req.file.path);
        fs.unlink(req.file.path, (err) => { if (err) console.error("Temp file cleanup failed:", err); });

        if (!rawText || rawText.trim().length < 50) {
            return res.status(400).json({ message: 'Could not extract enough text.' });
        }

        // 🚀 THE FIX: CHAIN OF THOUGHT FORCING
        // We force the AI to count the items first. This prevents it from "truncating" the list.
        const systemInstruction = `You are a data-extraction API. Read raw resume text and map it EXACTLY to the JSON schema.
        
        MANDATORY RULES:
        1. ZERO DATA LOSS: You MUST extract EVERY SINGLE experience and EVERY SINGLE project found in the text.
        2. THE EXTRACTION PLAN: You MUST output an "_extraction_plan" object FIRST. Count how many jobs and projects are in the raw text. 
        3. STRICT FORMATTING: Skills must be grouped by category (e.g., "Languages", "Cloud"). DO NOT return flat string lists.
        4. NO TRUNCATION: You are strictly forbidden from cutting off the list.`;

        const prompt = `RAW TEXT TO PARSE:
        ${rawText}
        
        Return a JSON object populating this EXACT schema:
        {
          "_extraction_plan": {
            "total_jobs_found": 2,
            "total_projects_found": 2
          },
          "personalInfo": {
            "firstName": "", "lastName": "", "email": "", "phone": "", "linkedin": "", "github": ""
          },
          "summary": "...",
          "experience": [
            { "company": "", "position": "", "startDate": "", "endDate": "", "description": ["bullet"] }
          ],
          "education": [
            { "institution": "", "degree": "", "fieldOfStudy": "" }
          ],
          "projects": [
            { "name": "", "description": ["bullet"] }
          ],
          "skills": [
            { "category": "Frontend", "items": ["HTML", "React"] }
          ]
        }`;

        const response = await openai.chat.completions.create({
            model: "llama-3.3-70b-versatile",
            messages: [
              { role: "system", content: systemInstruction },
              { role: "user", content: prompt }
            ],
            response_format: { type: "json_object" },
            temperature: 0.05, 
            max_tokens: 8000, // Maximized token allowance
        });

        let rawResponseText = response.choices[0].message.content;
        
        // Robust cleanup: find first '{' and last '}'
        const first = rawResponseText.indexOf('{');
        const last = rawResponseText.lastIndexOf('}');
        rawResponseText = rawResponseText.substring(first, last + 1);

        const parsedJSON = JSON.parse(rawResponseText);
        
        // 🚀 CLEANUP: Remove extraction plan before sending to frontend
        delete parsedJSON._extraction_plan;

        res.status(200).json({ resumeData: parsedJSON });

    } catch (error) {
        console.error("Import Error:", error);
        res.status(500).json({ message: 'Failed to process PDF import.', error: error.message });
    }
};

module.exports = { importResume };
