import React, { useState } from 'react';
import { useResumeStore } from '../store/useResumeStore';
import { Sparkles, Loader2, Plus, RotateCcw, ArrowRight, Target, Check, X, CheckCircle2, AlertCircle } from 'lucide-react';

export const AnalysisPanel = () => {
  const { 
    generateBulletOptions, 
    isTailoring, 
    generatedBullets, 
    appendBulletToResume, 
    updateResumeData, 
    activeResume, 
    clearGeneratedBullets,
    addSkillToCategory,
    removeSkillFromResume
  } = useResumeStore();
  
  const [jdText, setJdText] = useState('');
  const [selectedTone, setSelectedTone] = useState('impact');
  const [appliedItems, setAppliedItems] = useState(new Set());

  const handleGenerate = async () => {
    if (jdText.trim().length < 20) return alert("Paste a valid job description.");
    await generateBulletOptions(jdText, selectedTone);
  };

  const handleReset = () => {
    clearGeneratedBullets();
    setJdText('');
    setAppliedItems(new Set());
  };

  const handleApplySummary = (newSummary, idx) => {
    updateResumeData({ ...activeResume.resumeData, summary: newSummary });
    setAppliedItems(prev => new Set(prev).add(`summary-${idx}`));
  };

  const handleApplyBullet = (sectionKey, itemTitle, bullet, uniqueId) => {
    appendBulletToResume(sectionKey, itemTitle, bullet);
    setAppliedItems(prev => new Set(prev).add(uniqueId));
  };

  const isGranularResponse = generatedBullets?.summaryOptions || generatedBullets?.skillsAudit || generatedBullets?.tailoredItems;
  const isOneShotResponse = generatedBullets?.success && generatedBullets?.atsScore;
  const isInvalidResponse = generatedBullets && !isGranularResponse && !isOneShotResponse;

  return (
    <div className="h-full flex flex-col bg-zinc-50 font-sans">
      
      <div className="px-5 py-4 bg-white border-b border-zinc-200 flex justify-between items-center sticky top-0 z-10">
        <div className="flex items-center gap-2">
            <Sparkles className="text-zinc-900" size={18} />
            <h2 className="text-sm font-semibold text-zinc-900 tracking-tight">AI Copilot</h2>
        </div>
        {generatedBullets && (
             <button onClick={handleReset} className="text-xs font-medium text-zinc-500 hover:text-zinc-900 flex items-center gap-1.5 transition-colors">
                 <RotateCcw size={14}/> Reset
             </button>
        )}
      </div>

      <div className="flex-1 overflow-y-auto custom-scrollbar p-5 space-y-8 pb-20">
        
        {!generatedBullets && (
            <div className="space-y-6 animate-in fade-in duration-300">
                <div className="space-y-2">
                    <label className="text-xs font-semibold text-zinc-800">Target Job Description</label>
                    <textarea 
                        value={jdText}
                        onChange={(e) => setJdText(e.target.value)}
                        className="w-full h-48 p-4 bg-white border border-zinc-200 rounded-xl outline-none focus:border-zinc-400 focus:ring-4 focus:ring-zinc-100 resize-none text-sm shadow-sm transition-all leading-relaxed placeholder:text-zinc-400"
                        placeholder="Paste the job requirements here to analyze gaps and generate targeted content..."
                    />
                </div>
                
                <div className="space-y-3">
                    <label className="text-xs font-semibold text-zinc-800">Writing Style</label>
                    <div className="grid grid-cols-1 gap-2">
                        {[
                            { id: 'impact', label: 'Professional & Balanced', desc: 'Strong action verbs and clear achievements.' },
                            { id: 'ats', label: 'Strategic & Optimized', desc: 'Aggressive keyword matching for ATS systems.' },
                            { id: 'authentic', label: 'Direct & Authentic', desc: 'Honest phrasing, highly defensible in interviews.' }
                        ].map(tone => (
                            <button 
                                key={tone.id}
                                onClick={() => setSelectedTone(tone.id)}
                                className={`text-left p-3 rounded-xl border text-sm transition-all flex flex-col gap-0.5 ${selectedTone === tone.id ? 'bg-zinc-900 border-zinc-900 text-white shadow-md' : 'bg-white border-zinc-200 text-zinc-700 hover:border-zinc-300'}`}
                            >
                                <span className="font-semibold">{tone.label}</span>
                                <span className={`text-xs ${selectedTone === tone.id ? 'text-zinc-300' : 'text-zinc-500'}`}>{tone.desc}</span>
                            </button>
                        ))}
                    </div>
                </div>

                <button 
                    onClick={handleGenerate} 
                    disabled={isTailoring}
                    className="w-full bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold py-3.5 rounded-xl shadow-md transition-all flex justify-center items-center gap-2 disabled:opacity-50"
                >
                    {isTailoring ? <Loader2 className="animate-spin" size={16} /> : <Sparkles size={16} />}
                    {isTailoring ? 'Analyzing Resume...' : 'Generate Tailored Content'}
                </button>
            </div>
        )}

        {generatedBullets && isOneShotResponse && !isGranularResponse && (
          <div className="flex flex-col items-center justify-center space-y-4 pt-10 animate-in zoom-in-95 duration-500">
            <div className="h-16 w-16 bg-emerald-100 rounded-full flex items-center justify-center mb-2 shadow-inner">
              <CheckCircle2 className="text-emerald-600" size={32} />
            </div>
            <h3 className="text-lg font-bold text-zinc-900">Optimization Complete!</h3>
            <p className="text-sm text-zinc-600 text-center px-4 leading-relaxed">
              Your resume has been completely rewritten and formatted directly on the canvas to match the target job description. 
            </p>
            
            <div className="mt-6 p-4 bg-white border border-zinc-200 rounded-xl w-full shadow-sm flex items-center justify-between">
              <div className="flex items-center gap-2">
                <Target className="text-zinc-400" size={18} />
                <span className="text-sm font-semibold text-zinc-700">Estimated ATS Match</span>
              </div>
              <span className="text-2xl font-black text-emerald-600">{generatedBullets.atsScore}%</span>
            </div>

            <button 
                onClick={handleReset} 
                className="w-full mt-6 bg-white border border-zinc-200 hover:bg-zinc-50 hover:border-zinc-300 text-zinc-800 text-sm font-semibold py-3 rounded-xl transition-all shadow-sm"
            >
                Optimize for another job
            </button>
          </div>
        )}

        {generatedBullets && isInvalidResponse && (
           <div className="flex flex-col items-center justify-center space-y-4 pt-10 animate-in zoom-in-95 duration-500">
             <div className="h-16 w-16 bg-red-100 rounded-full flex items-center justify-center mb-2 shadow-inner">
               <AlertCircle className="text-red-600" size={32} />
             </div>
             <h3 className="text-lg font-bold text-zinc-900">Data Format Error</h3>
             <p className="text-sm text-zinc-600 text-center px-4 leading-relaxed">
               The AI backend returned a response, but it did not match the expected granular structure or the one-shot structure. Please verify your backend API output.
             </p>
             <button 
                 onClick={handleReset} 
                 className="w-full mt-6 bg-white border border-zinc-200 hover:bg-zinc-50 hover:border-zinc-300 text-zinc-800 text-sm font-semibold py-3 rounded-xl transition-all shadow-sm"
             >
                 Try Again
             </button>
           </div>
        )}

        {generatedBullets && isGranularResponse && (
          <div className="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
            
            {generatedBullets.summaryOptions && generatedBullets.summaryOptions.length > 0 && (
                <div className="space-y-3">
                    <h3 className="text-xs font-semibold text-zinc-800 flex items-center gap-2">
                        <Target size={14} className="text-zinc-400"/> Professional Summary
                    </h3>
                    <div className="space-y-3">
                        {generatedBullets.summaryOptions?.map((opt, idx) => {
                            const isApplied = appliedItems.has(`summary-${idx}`);
                            return (
                                <div key={idx} className="p-4 bg-white border border-zinc-200 rounded-xl shadow-sm hover:border-zinc-300 transition-all group relative pr-14">
                                    <p className="text-sm text-zinc-700 leading-relaxed">{opt}</p>
                                    <button 
                                        onClick={() => handleApplySummary(opt, idx)}
                                        className={`absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-lg transition-all ${isApplied ? 'bg-emerald-50 text-emerald-600' : 'bg-zinc-100 text-zinc-600 hover:bg-zinc-900 hover:text-white opacity-0 group-hover:opacity-100'}`}
                                        title="Apply to Resume"
                                    >
                                        {isApplied ? <Check size={16} /> : <Plus size={16} />}
                                    </button>
                                </div>
                            );
                        })}
                    </div>
                </div>
            )}

            {generatedBullets.skillsAudit && (
              <div className="space-y-4">
                  <h3 className="text-xs font-semibold text-zinc-800 flex items-center gap-2">
                      <Target size={14} className="text-zinc-400"/> Skills Gap Analysis
                  </h3>
                  
                  {generatedBullets.skillsAudit.add?.length > 0 && (
                      <div className="p-4 bg-white border border-zinc-200 rounded-xl shadow-sm space-y-4">
                          <p className="text-xs font-medium text-zinc-500">Click to add missing keywords.</p>
                          {generatedBullets.skillsAudit.add?.map((group, idx) => {
                              if (typeof group === 'string') {
                                return (
                                  <button 
                                    key={idx} onClick={() => addSkillToCategory('Recommended', group)}
                                    className="px-3 py-1.5 inline-flex bg-emerald-50 text-emerald-700 border border-emerald-100 hover:border-emerald-300 rounded-lg text-xs font-medium transition-colors items-center gap-1.5 mr-2 mb-2"
                                  >
                                      <Plus size={12} /> {group}
                                  </button>
                                );
                              }
                              
                              const itemsArray = group.items || group.skills || [];
                              
                              return (
                                <div key={idx} className="space-y-2">
                                    <span className="text-xs font-semibold text-zinc-800">{group.category || 'General'}</span>
                                    <div className="flex flex-wrap gap-2">
                                        {itemsArray?.map((skill, sIdx) => (
                                            <button 
                                                key={sIdx} 
                                                onClick={() => addSkillToCategory(group.category || 'General', skill)}
                                                className="px-3 py-1.5 bg-emerald-50 text-emerald-700 border border-emerald-100 hover:border-emerald-300 rounded-lg text-xs font-medium transition-colors flex items-center gap-1.5"
                                            >
                                                <Plus size={12} /> {skill}
                                            </button>
                                        ))}
                                    </div>
                                </div>
                              );
                          })}
                      </div>
                  )}
                  
                  {generatedBullets.skillsAudit.remove?.length > 0 && (
                      <div className="p-4 bg-white border border-zinc-200 rounded-xl shadow-sm space-y-3">
                          <p className="text-xs font-medium text-zinc-500">Click to remove irrelevant skills.</p>
                          <div className="flex flex-wrap gap-2">
                              {generatedBullets.skillsAudit.remove?.map((skill, i) => (
                                  <button 
                                    key={i} 
                                    onClick={() => removeSkillFromResume(skill)}
                                    className="px-3 py-1.5 bg-red-50 text-red-600 border border-red-100 hover:border-red-300 rounded-lg text-xs font-medium line-through transition-colors flex items-center gap-1.5"
                                  >
                                      <X size={12} /> {skill}
                                  </button>
                              ))}
                          </div>
                      </div>
                  )}
              </div>
            )}

            {generatedBullets.tailoredItems?.map((itemGroup, idx) => (
              <div key={idx} className="space-y-3">
                  <h3 className="text-xs font-semibold text-zinc-800 flex items-center gap-2">
                      <Target size={14} className="text-zinc-400"/> {itemGroup.itemTitle}
                  </h3>
                  
                  {itemGroup.rewrittenBullets?.map((bullet, bIdx) => {
                      const uniqueId = `rw-${idx}-${bIdx}`;
                      const isApplied = appliedItems.has(uniqueId);
                      return (
                          <div key={bIdx} className="p-4 bg-white border border-zinc-200 rounded-xl shadow-sm hover:border-zinc-300 transition-all group relative pr-14">
                              <span className="absolute top-3 left-3 w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                              <p className="text-sm text-zinc-700 leading-relaxed pl-3">{bullet}</p>
                              <button 
                                  onClick={() => handleApplyBullet(itemGroup.sectionKey, itemGroup.itemTitle, bullet, uniqueId)}
                                  className={`absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-lg transition-all ${isApplied ? 'bg-emerald-50 text-emerald-600' : 'bg-zinc-100 text-zinc-600 hover:bg-zinc-900 hover:text-white opacity-0 group-hover:opacity-100'}`}
                              >
                                  {isApplied ? <Check size={16} /> : <ArrowRight size={16} />}
                              </button>
                          </div>
                      );
                  })}

                  {itemGroup.newSuggestions?.map((bullet, bIdx) => {
                      const uniqueId = `new-${idx}-${bIdx}`;
                      const isApplied = appliedItems.has(uniqueId);
                      return (
                          <div key={bIdx} className="p-4 bg-zinc-100 border border-zinc-200 rounded-xl hover:border-zinc-300 transition-all group relative pr-14">
                              <span className="absolute top-3 left-3 w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                              <p className="text-sm text-zinc-800 leading-relaxed pl-3">{bullet}</p>
                              <button 
                                  onClick={() => handleApplyBullet(itemGroup.sectionKey, itemGroup.itemTitle, bullet, uniqueId)}
                                  className={`absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-lg transition-all ${isApplied ? 'bg-emerald-50 text-emerald-600' : 'bg-white text-zinc-600 hover:bg-zinc-900 hover:text-white shadow-sm opacity-0 group-hover:opacity-100'}`}
                              >
                                  {isApplied ? <Check size={16} /> : <Plus size={16} />}
                              </button>
                          </div>
                      );
                  })}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
};
</file>

