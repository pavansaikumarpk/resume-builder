/* src/editor/editor.module.css */

.container {
  @apply h-full overflow-y-auto p-6 lg:p-10 relative bg-zinc-50;
}

.wrapper {
  @apply max-w-3xl mx-auto space-y-6 pb-32;
}

/* Header */
.header {
  @apply flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8;
}

.title {
  @apply text-2xl font-black text-zinc-900 tracking-tight;
}

.subtitle {
  @apply text-zinc-500 text-sm mt-1;
}

.actions {
  @apply flex items-center gap-3 w-full md:w-auto;
}

.btnSecondary {
  @apply flex-1 md:flex-none flex justify-center items-center gap-2 bg-white border border-zinc-200 hover:border-zinc-300 text-zinc-700 px-4 py-2.5 rounded-lg font-semibold shadow-sm transition-all text-sm disabled:opacity-50;
}

.btnPrimary {
  @apply flex-1 md:flex-none flex justify-center items-center gap-2 bg-zinc-900 text-white px-4 py-2.5 rounded-lg font-semibold hover:bg-zinc-800 shadow-md transition-all text-sm;
}

/* Inputs */
.inputGroup {
  @apply flex flex-col gap-1.5 w-full mt-2;
}

.inputLabel {
  @apply text-[10px] font-bold text-zinc-500 uppercase tracking-widest flex items-center gap-1.5 ml-0.5;
}

.textareaLabel {
  @apply text-[10px] font-bold text-zinc-500 uppercase tracking-widest ml-0.5;
}

.inputField {
  @apply w-full bg-white border border-zinc-200 rounded-lg px-3.5 py-2.5 text-sm text-zinc-900 placeholder:text-zinc-400 outline-none focus:border-zinc-400 focus:ring-4 focus:ring-zinc-100 transition-all shadow-[0_1px_2px_rgba(0,0,0,0.02)];
}

.textareaField {
  @apply w-full bg-white border border-zinc-200 rounded-lg px-3.5 py-2.5 text-sm text-zinc-900 placeholder:text-zinc-400 outline-none focus:border-zinc-400 focus:ring-4 focus:ring-zinc-100 transition-all resize-y shadow-[0_1px_2px_rgba(0,0,0,0.02)] leading-relaxed;
}

/* Accordions / Sortable Sections */
.sectionCard {
  @apply bg-white rounded-xl mb-4 transition-all duration-200 border shadow-sm;
}

.sectionCardDragging {
  @apply border-zinc-300 shadow-2xl scale-[1.02] opacity-90;
}

.sectionCardIdle {
  @apply border-zinc-200 hover:border-zinc-300;
}

.sectionHeader {
  @apply flex items-center justify-between p-4 bg-white rounded-xl cursor-pointer;
}

.sectionHeaderLeft {
  @apply flex items-center gap-3 flex-1;
}

.dragHandle {
  @apply p-1 text-zinc-300 cursor-grab hover:text-zinc-900 hover:bg-zinc-100 rounded transition-colors;
}

.sectionTitleInput {
  @apply text-sm font-bold text-zinc-900 tracking-wide bg-transparent border-b border-transparent hover:border-zinc-300 focus:border-zinc-900 focus:outline-none w-full max-w-[250px] transition-all;
}

.sectionHeaderRight {
  @apply flex items-center gap-1;
}

.iconBtn {
  @apply p-1.5 rounded-md transition-colors;
}

.iconBtnDanger {
  @apply text-zinc-400 hover:text-red-600 hover:bg-red-50;
}

.iconBtnNeutral {
  @apply text-zinc-400 group-hover:text-zinc-600;
}

.sectionBody {
  @apply transition-all duration-300 ease-in-out origin-top;
}

.sectionBodyExpanded {
  @apply h-auto opacity-100 p-6 pt-2 border-t border-zinc-100 bg-zinc-50/30 rounded-b-xl;
}

.sectionBodyCollapsed {
  @apply h-0 opacity-0 overflow-hidden;
}

/* Data Blocks inside Accordions */
.dataBlock {
  @apply p-5 bg-white border border-zinc-200 rounded-xl relative shadow-[0_1px_2px_rgba(0,0,0,0.02)] transition-all hover:border-zinc-300 mb-6 mt-2;
}

.deleteBlockBtn {
  @apply absolute top-4 right-4 p-1.5 text-zinc-400 hover:bg-red-50 hover:text-red-600 rounded-md transition-colors z-10;
}

.grid2 {
  @apply grid grid-cols-1 md:grid-cols-2 gap-5 mb-5;
}

.colSpan2 {
  @apply md:col-span-2;
}

.addBlockBtn {
  @apply w-full py-3.5 border border-dashed border-zinc-300 text-zinc-600 text-sm font-semibold rounded-xl hover:border-zinc-400 hover:bg-white transition-all flex justify-center items-center gap-2 shadow-sm;
}
