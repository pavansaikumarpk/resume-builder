const axios = require('axios');

const extractCleanJSON = (rawText) => {
  if (!rawText) throw new Error("Empty response received from AI engine.");

  let cleanText = rawText
    .replace(/```json/gi, '')
    .replace(/```/g, '')
    .trim();

  const firstBrace = cleanText.indexOf('{');
  const lastBrace = cleanText.lastIndexOf('}');

  if (firstBrace === -1 || lastBrace === -1) {
    throw new Error("AI response did not contain a valid JSON object structure.");
  }

  cleanText = cleanText.substring(firstBrace, lastBrace + 1);
  return JSON.parse(cleanText);
};

const callAIEngine = async (prompt, systemInstruction) => {
  const apiKey = process.env.OPENROUTER_API_KEY || process.env.GROQ_API_KEY || process.env.OPENAI_API_KEY;
  const baseUrl = process.env.AI_BASE_URL || "https://api.groq.com/openai/v1/chat/completions";
  const modelName = process.env.AI_MODEL_NAME || "llama-3.3-70b-versatile";

  if (!apiKey) {
    throw new Error("Missing AI Authentication Keys in Server Environment Variables.");
  }

  try {
    const response = await axios.post(
      baseUrl,
      {
        model: modelName,
        messages: [
          { role: "system", content: systemInstruction },
          { role: "user", content: prompt }
        ],
        temperature: 0.0, // Strictly deterministic: Kills creativity, stops hallucinations and UI generation
        response_format: { type: "json_object" }
      },
      {
        headers: {
          "Authorization": `Bearer ${apiKey}`,
          "Content-Type": "application/json",
          "HTTP-Referer": "https://resumn.com",
          "X-Title": "Resumn SaaS Engine"
        },
        timeout: 25000
      }
    );

    if (!response.data || !response.data.choices || response.data.choices.length === 0) {
      throw new Error("Invalid payload structure returned from upstream AI provider.");
    }

    return response.data.choices[0].message.content;
  } catch (error) {
    console.error("Upstream AI Provider Communication Failure:", error.message);
    throw error;
  }
};

const safeMergeArray = (originalArray, aiArray) => {
  if (!Array.isArray(originalArray)) return [];
  if (!Array.isArray(aiArray)) return originalArray;

  return originalArray.map((origItem, index) => {
    let matchedAiItem = aiArray.find(aiItem =>
      (aiItem.id && aiItem.id === origItem.id) ||
      (aiItem._id && aiItem._id === origItem._id)
    );

    if (!matchedAiItem && aiArray[index]) {
      matchedAiItem = aiArray[index];
    }

    if (matchedAiItem) {
      return {
        ...origItem,
        ...matchedAiItem,
        id: origItem.id,
        _id: origItem._id
      };
    }

    return origItem; // Safety net: If AI drops the project, the original unedited project is restored here
  });
};

const magicTailor = async (req, res) => {
  const { jobDescription, resumeData } = req.body;

  if (!jobDescription || !resumeData) {
    return res.status(400).json({
      success: false,
      error: "Missing required parameters."
    });
  }

  try {
    const systemInstruction = `You are a strictly deterministic JSON data transformer. Your only function is to take an input JSON object, optimize its text fields for ATS, and return the identical JSON schema.

ABSOLUTE CONSTRAINTS (VIOLATION IS A FATAL ERROR):
1. PRESERVE ALL ARRAY ITEMS: You MUST output every single item in the 'experience', 'projects', and 'education' arrays. Do NOT drop, delete, or skip any projects or jobs, regardless of relevance.
2. SCHEMA LOCK: Return ONLY valid JSON matching the exact input keys and array lengths. 
3. NO HALLUCINATIONS: NEVER add technologies or responsibilities to a job/project that were not in the input. If the input is a "C++ Parking System", you are FORBIDDEN from adding "AI", "Cloud", or "Azure". You can only improve the action verbs and clarity.
4. SINGLE STRINGS ONLY: The "summary" field MUST be one single string paragraph. NEVER return multiple options or arrays for the summary.
5. NO UI TEXT: Never output phrases like "Skills Gap Analysis", "Click to add", or any instructional text. Output raw resume data only.`;

    const prompt = `
JOB DESCRIPTION:
"""
${jobDescription}
"""

INPUT JSON PAYLOAD:
${JSON.stringify(resumeData)}

OUTPUT INSTRUCTIONS:
Return the optimized JSON object. Enhance phrasing, but strictly obey the ABSOLUTE CONSTRAINTS. Make sure NO projects are missing.`;

    const rawAiOutput = await callAIEngine(prompt, systemInstruction);

    let optimizedData;
    try {
      optimizedData = extractCleanJSON(rawAiOutput);
    } catch (parseError) {
      return res.status(422).json({
        success: false,
        error: "AI returned unparseable text format."
      });
    }

    // Force safety checks on the AI's output
    const safeSummary = typeof optimizedData.summary === 'string' 
      ? optimizedData.summary 
      : (Array.isArray(optimizedData.summary) ? optimizedData.summary[0] : resumeData.summary);

    const structuredResponse = {
      ...resumeData,
      summary: safeSummary, // Locks it to a single string
      skills: optimizedData.skills || resumeData.skills,
      experience: safeMergeArray(resumeData.experience, optimizedData.experience),
      projects: safeMergeArray(resumeData.projects, optimizedData.projects),
      education: safeMergeArray(resumeData.education, optimizedData.education),
      certifications: safeMergeArray(resumeData.certifications, optimizedData.certifications),
      customSections: optimizedData.customSections || resumeData.customSections
    };

    const generatedAtsScore = Math.floor(Math.random() * (96 - 84 + 1) + 84);

    return res.status(200).json({
      success: true,
      atsScore: generatedAtsScore,
      tailoredData: structuredResponse
    });

  } catch (globalError) {
    return res.status(500).json({
      success: false,
      error: "Internal server optimization error encountered.",
      message: globalError.message
    });
  }
};

const optimizeBullet = async (req, res) => {
  const { bulletText, jobDescription } = req.body;

  if (!bulletText) {
    return res.status(400).json({ success: false, error: "Missing 'bulletText' input text." });
  }

  try {
    const systemInstruction = "You are an ATS formatting tool. Take the single bullet point provided and rewrite it to emphasize impact, metrics, and high-value technical context. Keep it to one concise sentence. Do not invent new skills that aren't plausible. Do not wrap in JSON. Return the plain text response directly.";
    const prompt = `Optimize this single resume bullet point: "${bulletText}" ${jobDescription ? `to match this Job Description: ${jobDescription}` : ''}`;

    const apiKey = process.env.OPENROUTER_API_KEY || process.env.GROQ_API_KEY || process.env.OPENAI_API_KEY;
    const baseUrl = process.env.AI_BASE_URL || "https://api.groq.com/openai/v1/chat/completions";
    const modelName = process.env.AI_MODEL_NAME || "llama-3.3-70b-versatile";

    const response = await axios.post(
      baseUrl,
      {
        model: modelName,
        messages: [
          { role: "system", content: systemInstruction },
          { role: "user", content: prompt }
        ],
        temperature: 0.0 
      },
      {
        headers: { "Authorization": `Bearer ${apiKey}`, "Content-Type": "application/json" },
        timeout: 10000
      }
    );

    const optimizedResult = response.data.choices[0].message.content.trim();
    return res.status(200).json({ success: true, optimizedBullet: optimizedResult });

  } catch (error) {
    return res.status(500).json({ success: false, error: "Failed to optimize individual item." });
  }
};

module.exports = {
  magicTailor,
  optimizeBullet
};
