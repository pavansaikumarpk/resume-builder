const renderSkillText = (text) => {
    if (typeof text === 'string' && text.includes(':')) {
        const parts = text.split(':');
        return <Text><Text style={{ fontWeight: 'bold' }}>{parts[0]}: </Text>{parts.slice(1).join(':')}</Text>;
    }
    return <Text>{text}</Text>;
};

